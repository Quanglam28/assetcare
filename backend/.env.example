# Cấu hình cổng máy chủ Backend API
PORT=5000
NODE_ENV=development

# Cấu hình kết nối Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_secure_password_here
DB_NAME=asset_maintenance_system
DB_CONNECTION_LIMIT=10

# Cấu hình bảo mật JSON Web Token (JWT)
# Vui lòng thay thế bằng chuỗi ngẫu nhiên có độ dài tối thiểu 32 ký tự trong môi trường Production
JWT_SECRET=replace_with_your_super_secret_jwt_random_key_here_32_chars_min
JWT_EXPIRES_IN=7d

# Cấu hình CORS cho Frontend Client
CLIENT_URL=http://localhost:5173

# Đường dẫn lưu trữ tệp tin tải lên (Hình ảnh sự cố, Avatar...)
UPLOAD_PATH=./uploads
